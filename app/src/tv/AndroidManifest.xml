<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- TV-only build: declare touchscreen as not required so the Play Store
         lists this APK on Android TV devices, and require leanback. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <application>
        <!-- Explicit banner/icon on the leanback-launcher activity. The TV launcher and
             Play Store TV reviewer pick up the activity-level banner first; without it
             they fall back to displaying the (square) icon in the rectangular tile,
             which is what triggered the "icon does not fill the entire icon space"
             rejection on Play TV review. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:banner="@drawable/arrambanner"
            android:icon="@mipmap/arramlauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
